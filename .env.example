# Скопируйте в .env.local и заполните значениями из консоли Supabase.
# Публичные ключи попадают в браузер — service_role и пароль БД сюда добавлять нельзя.

# Supabase: Project Settings → API → anon / publishable key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# demo | supabase
VITE_DATA_MODE=demo

# Вход администратора по короткому логину (по умолчанию Administrator)
VITE_ADMIN_LOGIN=Administrator
VITE_ADMIN_EMAIL=admin@createtoy.local
